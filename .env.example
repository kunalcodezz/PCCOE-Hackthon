# ==========================================
# RE:LOOP Environment Variables Configuration
# ==========================================

# Server-Side Google Gemini API Key
# Used securely by the /api/analyze-waste serverless endpoint.
# NEVER prefix with VITE_ to prevent leaking the secret to the browser bundle.
GEMINI_API_KEY=

# Optional: Firebase Client Configuration (falls back to reactive in-memory state)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
